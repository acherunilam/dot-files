#!/usr/bin/env bash

################################################################################
# Global variables.
################################################################################

_NAME="$(basename "$0")"
_HELP_DOC="Upload text to rustypaste, a self-hosted pastebin. If
nothing is piped in, then the contents of the clipboard will be used (macOS only).

Usage:
  $_NAME [options]
  cat <message.txt> | $_NAME [options]

Options:
  -b	Burn the paste after it's opened once.
  -h	Print help.

Environment variables:
  PASTEBIN_AUTH_BASIC
  PASTEBIN_URL"
CURL_ARGS="--connect-timeout 2 --max-time 10"
SKIP_HTTP_PREFIX='true'

################################################################################
# Helper methods.
################################################################################

# Usage:
#       error <message> [<exit_code>]
error() {
	[[ ${2:-1} -eq 0 ]] && std_err_or_out=1 || std_err_or_out=2
	echo "$_NAME: $1" >&"$std_err_or_out"
	exit "${2:-1}"
}

# Usage:
#       echo "text message" | pbcopy
pbcopy() {
	content="$(</dev/stdin)"
	if type -P pbcopy >/dev/null; then
		echo -n "$content" | command pbcopy
		return
	fi
	# Without a clipboard of our own, ask the terminal to set it (OSC 52). GNU
	# base64 wraps its output and BSD base64 doesn't, so join the lines either way.
	output="$(printf '\e]52;c;%s\a' "$(echo -n "$content" | base64 | tr -d '\n')")"
	# shellcheck disable=SC1003
	[[ -n "$TMUX" ]] && output="$(printf '\ePtmux;\e%s\e\\' "$output")"
	printf "%s" "$output"
}

################################################################################
# Validate input.
################################################################################

# Move options ahead of any argument so getopts sees them wherever they were passed.
options=()
operands=()
for arg in "$@"; do
	[[ "$arg" == -?* ]] && options+=("$arg") || operands+=("$arg")
done
set -- "${options[@]}" "${operands[@]}"
upload_field="file"
while getopts ":bh" arg; do
	case $arg in
	b) # burn
		upload_field="oneshot"
		;;
	h) # help
		echo "$_HELP_DOC" && exit
		;;
	*)
		echo "$_HELP_DOC" >&2 && exit 64 # EX_USAGE
		;;
	esac
done
shift $((OPTIND - 1))

[[ -z "$PASTEBIN_URL" ]] && error "missing environment variable, please set PASTEBIN_URL" 78 # EX_CONFIG
[[ $# -gt 0 ]] && error "invalid input, please pass the text via STDIN rather than as an argument" 64 # EX_USAGE
# Upload the content byte for byte from a file, as holding it in a variable
# drops NUL bytes and trailing newlines.
content_file="$(mktemp)" || error "unable to create a temporary file" 73 # EX_CANTCREAT
trap 'rm -f "$content_file"' EXIT
if [[ -t 0 ]] || ! { : </dev/stdin; } 2>/dev/null; then # nothing piped in, or STDIN is closed
	type -P pbpaste >/dev/null && pbpaste >"$content_file"
	[[ -s "$content_file" ]] || error "missing input, please pass the text via STDIN" 64 # EX_USAGE
else
	# Only fall back on the clipboard when nothing was piped at all, or an empty
	# pipeline would quietly upload whatever happens to be on the clipboard.
	cat >"$content_file"
	[[ -s "$content_file" ]] || error "missing input, nothing was received on STDIN" 64 # EX_USAGE
fi

################################################################################
# Execute.
################################################################################

curl_auth_args=()
[[ -n $PASTEBIN_AUTH_BASIC ]] && curl_auth_args=(-u "$PASTEBIN_AUTH_BASIC")
# shellcheck disable=SC2086
response="$(
	curl -qfsS $CURL_ARGS "${curl_auth_args[@]}" -F "$upload_field=@$content_file" \
		"${PASTEBIN_URL%/}"
)" || error "unable to upload to $PASTEBIN_URL" 69 # EX_UNAVAILABLE
[[ -z "$response" ]] && error "unknown error, missing response" 76 # EX_PROTOCOL
[[ -n "$SKIP_HTTP_PREFIX" ]] && response="$(sed -E 's|https?://||g' <<<"$response")"
echo "$response"
[[ -t 1 ]] && echo -n "$response" | pbcopy
exit 0
