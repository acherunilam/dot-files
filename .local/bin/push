#!/usr/bin/env bash

################################################################################
# Global variables.
################################################################################

_NAME="$(basename "$0")"
_HELP_DOC="Send a push notification using Pushover, a push notification service.

Usage:
  $_NAME [options] <text_message>

Options:
  -p    Send message with high priority.
  -h    Print help.

Environment variables:
  PUSHOVER_USER		https://pushover.net
  PUSHOVER_TOKEN	https://pushover.net/apps/build"
CURL_ARGS="--connect-timeout 2 --max-time 10"

################################################################################
# Helper methods.
################################################################################

# Usage:
#       error <message> [<exit_code>]
error() {
	[[ ${2:-1} -eq 0 ]] && std_err_or_out=1 || std_err_or_out=2
	echo "$_NAME: $1" >&"$std_err_or_out"
	exit "${2:-1}"
}

# Usage:
#       quote_curl_config <value>
quote_curl_config() {
	local value="${1//\\/\\\\}"
	printf '"%s"' "${value//\"/\\\"}"
}

################################################################################
# Validate input.
################################################################################

priority=0
while getopts ":ph" arg; do
	case $arg in
	p) # priority
		priority=1
		;;
	h) # help
		echo "$_HELP_DOC" && exit
		;;
	*)
		echo "$_HELP_DOC" >&2 && exit 64 # EX_USAGE
		;;
	esac
done
shift $((OPTIND - 1))
[[ "${!#}" == "-p" ]] && priority=1 && set -- "${@:1:$#-1}"

[[ -z "$PUSHOVER_USER" ]] && error "missing environment variable, please set PUSHOVER_USER" 78   # EX_CONFIG
[[ -z "$PUSHOVER_TOKEN" ]] && error "missing environment variable, please set PUSHOVER_TOKEN" 78 # EX_CONFIG
[[ -z "$*" ]] && error "missing input, please pass a message" 64                                  # EX_USAGE

################################################################################
# Execute.
################################################################################

# Hand the keys over as a config on STDIN, as any user can read the arguments
# of a running curl.
# shellcheck disable=SC2086
response="$(
	printf 'form-string = %s\nform-string = %s\n' \
		"$(quote_curl_config "user=$PUSHOVER_USER")" \
		"$(quote_curl_config "token=$PUSHOVER_TOKEN")" |
		curl -qsS $CURL_ARGS --config - \
			--form-string "priority=$priority" \
			--form-string "message=$*" \
			"https://api.pushover.net/1/messages.json"
)" || error "unable to reach pushover.net" 69 # EX_UNAVAILABLE
if grep -q '"user":"invalid"' <<<"$response"; then
	error "invalid user, please check the environment variable PUSHOVER_USER" 78 # EX_CONFIG
elif grep -q '"token":"invalid"' <<<"$response"; then
	error "invalid token, please check the environment variable PUSHOVER_TOKEN" 78 # EX_CONFIG
elif ! grep -q '"status":1' <<<"$response"; then
	error "unknown error: $response"
fi
