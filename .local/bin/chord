#!/usr/bin/env bash

################################################################################
# Global variables.
################################################################################

_NAME="$(command basename "$0")"
DEFAULT_DURATION=1
DEFAULT_OCTAVE=3
DEFAULT_TRANSPOSE=0
DEFAULT_INVERSION=0
VELOCITY=100
# Expands a chord symbol to MIDI numbers, voiced upwards from the base octave.
# tonal matches symbols against a fixed dictionary rather than composing them, so
# anything it does not carry is rebuilt from the longest chord type it does
# recognize plus the modifiers left over. A symbol that cannot be read comes back
# as "-", and one that runs past MIDI 127 as "!".
_CHORD_SCRIPT='
const { Chord, ChordType, Interval, Note } = require("tonal");

// Spellings the tonal dictionary lacks, taught to it rather than parsed here.
const ALIASES = [
	["maj7", "ma7"], ["maj7", "Ma7"], ["maj9", "ma9"], ["maj13", "ma13"],
	["m", "mi"], ["m7", "mi7"], ["m9", "mi9"], ["m11", "mi11"], ["m13", "mi13"],
	["m7b5", "min7b5"], ["m7b5", "mi7b5"], ["m7b5", "m7-5"], ["mMaj7", "minmaj7"],
	["m6", "mi6"], ["dim", "min(b5)"],
];
for (const [type, alias] of ALIASES) {
	if (!ChordType.get(type).empty && ChordType.get(alias).empty) ChordType.addAlias(ChordType.get(type), alias);
}

const PERFECT = new Set([1, 4, 5, 11]);

// The longest opening of a suffix that tonal recognizes as a chord type.
const longestType = (suffix) => {
	for (let i = suffix.length; i > 0; i--) {
		const type = ChordType.get(suffix.slice(0, i));
		if (!type.empty) return { type, length: i };
	}
	return null;
};

// A tonal interval name for a scale degree with an optional accidental.
const intervalFor = (degree, accidental) => {
	if (accidental === "#") return degree + "A";
	if (accidental === "b") return degree + (PERFECT.has(degree) ? "d" : "m");
	return degree + (PERFECT.has(degree) ? "P" : "M");
};

// Applies the modifiers no dictionary can enumerate to a set of base intervals.
const applyModifiers = (base, modifiers) => {
	let intervals = base;
	let rest = modifiers;
	let m;
	const eat = (re) => {
		const found = rest.match(re);
		if (found) rest = rest.slice(found[0].length);
		return found;
	};
	const without = (degree) => intervals.filter((iv) => Interval.get(iv).num !== degree);

	while (rest.length) {
		if ((m = eat(/^sus\s*(2|4)?/))) {
			intervals = without(3).concat(intervalFor(m[1] === "2" ? 2 : 4, ""));
		} else if ((m = eat(/^add\s*([#b]?)(2|4|6|9|11|13)/))) {
			intervals = intervals.concat(intervalFor(+m[2], m[1]));
		} else if ((m = eat(/^(?:no|omit)\s*(3|5)/))) {
			intervals = without(+m[1]);
		} else if ((m = eat(/^\/(9|11|13)/))) {
			intervals = intervals.concat(intervalFor(+m[1], ""));
		} else if ((m = eat(/^([#b+-])\s*(5|6|9|11|13)/))) {
			const degree = +m[2];
			intervals = without(degree).concat(intervalFor(degree, m[1] === "#" || m[1] === "+" ? "#" : "b"));
		} else if (eat(/^[()\s,|]/)) {
			continue;
		} else {
			// A chord type written inside the modifiers, as in Cm(maj7) or Cdim9,
			// contributes the degrees the base chord does not already carry.
			const nested = rest.length && longestType(rest);
			if (!nested) return null;
			const have = new Set(intervals.map((iv) => Interval.get(iv).num));
			intervals = intervals.concat(nested.type.intervals.filter((iv) => !have.has(Interval.get(iv).num)));
			rest = rest.slice(nested.length);
		}
	}
	return intervals;
};

// Resolves a chord symbol to MIDI numbers, voiced upwards from the base octave.
function chordMidi(symbol, baseOctave) {
	const voice = (names) => {
		const midis = [];
		let octave = baseOctave, previous = -1;
		for (const name of names) {
			let midi = Note.midi(name + octave);
			while (midi !== null && midi <= previous) { octave++; midi = Note.midi(name + octave); }
			if (midi === null) return null;
			midis.push(midi); previous = midi;
		}
		return midis;
	};

	const built = Chord.get(symbol);
	if (!built.empty) return voice(built.notes);

	const [root, type, bass] = Chord.tokenize(symbol);
	const rootMidi = root ? Note.midi(root + baseOctave) : null;
	if (rootMidi === null) return null;

	// Take the longest opening tonal recognizes whose remainder also reads.
	let intervals = null;
	for (let i = type.length; i >= 0 && intervals === null; i--) {
		const base = ChordType.get(type.slice(0, i));
		if (base.empty) continue;
		intervals = applyModifiers([...base.intervals], type.slice(i));
	}
	if (intervals === null) return null;

	const semis = [...new Set(intervals.map((iv) => Interval.semitones(iv)))].sort((a, b) => a - b);
	const midis = semis.map((s) => rootMidi + s);
	if (bass) {
		const bassMidi = Note.midi(bass + baseOctave);
		if (bassMidi === null) return null;
		const below = rootMidi - ((((rootMidi - bassMidi) % 12) + 12) % 12);
		if (below !== rootMidi) midis.unshift(below);
	}
	return midis;
}

const argv = process.argv.slice(1);
// Middle C is C4 in tonal but C3 in SendMIDI, so shift an octave up.
const midis = chordMidi(argv[1], parseInt(argv[0], 10) + 1);
if (midis === null) console.log("-");
else if (midis.some((m) => m < 0 || m > 127)) console.log("!");
else console.log(midis.join(" "));
'
_HELP_DOC="Play a chord.

Usage:
  $_NAME [options] <chord>

Options:
  -p <port>	MIDI output port, matched on any part of the name.
  -d <seconds>	Seconds to hold the notes [default: $DEFAULT_DURATION].
  -o <octaves>	Octaves to transpose, such as +1 or -2 [default: $DEFAULT_TRANSPOSE].
  -i <number>	Inversion to play, 0 being root position [default: $DEFAULT_INVERSION].
  -h		Print help.

Environment variables:
  MIDI_PORT"

################################################################################
# Helper methods.
################################################################################

# Usage:
#       error <message> [<exit_code>]
error() {
	[[ $2 -eq 0 ]] && std_err_or_out=1 || std_err_or_out=2
	builtin echo "$_NAME: $1" >&"$std_err_or_out"
	exit "${2:-1}"
}

# Usage:
#       check_if_installed <binary>
check_if_installed() {
	builtin hash "$1" 2>/dev/null || error "please install '$1' ($2)" 69 # EX_UNAVAILABLE
}

# Usage:
#       check_if_module_installed <module>
# A node module ships no binary of its own, so it cannot be looked up on PATH.
check_if_module_installed() {
	command node -e "require(\"$1\")" 2>/dev/null ||
		error "please install '$1' (npm install --global $1)" 69 # EX_UNAVAILABLE
}

# Usage:
#       seconds_to_timestamp <seconds>
seconds_to_timestamp() {
	# SendMIDI ignores timestamps that aren't fully zero padded, so always emit
	# the widest +HH:MM:SS.mmm form.
	command awk -v seconds="$1" 'BEGIN {
		ms = int(seconds * 1000 + 0.5)
		h = int(ms / 3600000); ms -= h * 3600000
		m = int(ms / 60000); ms -= m * 60000
		s = int(ms / 1000); ms -= s * 1000
		printf "+%02d:%02d:%02d.%03d", h, m, s, ms
	}'
}

# Usage:
#       resolve_chord <symbol>
resolve_chord() {
	# The global install is only on NODE_PATH once the shell profile is sourced.
	if [[ -z "$NODE_PATH" ]]; then
		NODE_PATH="$(command npm root -g 2>/dev/null)"
		export NODE_PATH
	fi
	command node -e "$_CHORD_SCRIPT" -- "$DEFAULT_OCTAVE" "$1" 2>/dev/null
}

# Usage:
#       silence_chord
silence_chord() {
	# Not every receiver acts on an All Notes Off, so release each note by name
	# and only fall back on the broadcast for anything already playing.
	local args=() midi
	for midi in "${chord[@]}"; do
		args+=(off "$midi" 0)
	done
	command sendmidi dev "$port" "${args[@]}" cc 123 0 2>/dev/null
	exit 130
}

################################################################################
# Validate input.
################################################################################

# getopts stops at the first chord, so move the options in front of it and let
# them be written anywhere on the line.
options=()
operands=()
while [[ $# -gt 0 ]]; do
	case "$1" in
	-[pdoi])                                                         # an option and its separate argument
		[[ $# -ge 2 ]] || { builtin echo "$_HELP_DOC" >&2 && exit 64; } # EX_USAGE
		options+=("$1" "$2")
		shift 2
		;;
	-[pdoi]*) # an option with its argument attached
		options+=("$1")
		shift
		;;
	--) # everything after this is a chord
		shift
		operands+=("$@")
		break
		;;
	-*)
		options+=("$1")
		shift
		;;
	*)
		operands+=("$1")
		shift
		;;
	esac
done
set -- "${options[@]}" "${operands[@]}"

port="$MIDI_PORT"
duration="$DEFAULT_DURATION"
octaves="$DEFAULT_TRANSPOSE"
inversion="$DEFAULT_INVERSION"
while getopts ":p:d:o:i:h" arg; do
	case $arg in
	p) # port
		port="$OPTARG"
		;;
	d) # duration
		duration="$OPTARG"
		;;
	o) # octaves
		octaves="$OPTARG"
		;;
	i) # inversion
		inversion="$OPTARG"
		;;
	h) # help
		builtin echo "$_HELP_DOC" && exit
		;;
	*)
		builtin echo "$_HELP_DOC" >&2 && exit 64 # EX_USAGE
		;;
	esac
done
shift $((OPTIND - 1))

check_if_installed "sendmidi" "https://github.com/gbevin/SendMIDI"

ports="$(command sendmidi list)"
[[ -z "$port" ]] &&
	error "missing port, please pass -p or set MIDI_PORT
${ports:+
Available ports:
$ports}" 78 # EX_CONFIG
command grep -qiF -- "$port" <<<"$ports" ||
	error "unknown port '$port'
${ports:+
Available ports:
$ports}" 78 # EX_CONFIG

[[ "$duration" =~ ^[0-9]+(\.[0-9]+)?$ ]] ||
	error "invalid duration '$duration', please pass a number of seconds" 64 # EX_USAGE
timestamp="$(seconds_to_timestamp "$duration")"
[[ "$timestamp" == "+00:00:00.000" ]] &&
	error "invalid duration '$duration', please pass at least 0.001 seconds" 64 # EX_USAGE

[[ "$octaves" =~ ^[+-]?[0-9]+$ ]] ||
	error "invalid transposition '$octaves', please pass a whole number of octaves" 64 # EX_USAGE

[[ "$inversion" =~ ^\+?[0-9]+$ ]] ||
	error "invalid inversion '$inversion', please pass zero or a positive whole number" 64 # EX_USAGE

[[ $# -eq 0 ]] && error "missing input, please pass a chord" 64        # EX_USAGE
[[ $# -gt 1 ]] && error "too many arguments, please pass one chord" 64 # EX_USAGE

# SendMIDI silently substitutes a wrong note for anything it can't parse, so
# resolve the chord up front and refuse to play a partial one.
check_if_installed "node" "https://nodejs.org"
midis="$(resolve_chord "$1")"
if [[ -z "$midis" ]]; then
	# Only pay for the second node start up on the path that already failed.
	check_if_module_installed "tonal"
	error "unable to read chord '$1'" 70 # EX_SOFTWARE
fi
[[ "$midis" == "-" ]] &&
	error "unknown chord '$1', please pass a symbol such as C, Cmaj7, or G7sus4/D" 65 # EX_DATAERR
[[ "$midis" == "!" ]] &&
	error "chord '$1' runs past the top of the MIDI range" 65 # EX_DATAERR

# shellcheck disable=SC2206
chord=($midis)
((inversion < ${#chord[@]})) ||
	error "chord '$1' has ${#chord[@]} notes, so its highest inversion is $((${#chord[@]} - 1))" 64 # EX_USAGE

# Each inversion lifts the lowest remaining note by an octave.
for ((i = 0; i < inversion; i++)); do
	chord[i]=$((chord[i] + 12))
done
readarray -t chord < <(printf "%s\n" "${chord[@]}" | command sort -n)

for i in "${!chord[@]}"; do
	chord[i]=$((chord[i] + octaves * 12))
	((chord[i] >= 0 && chord[i] <= 127)) ||
		error "'$1' inverted $inversion and transposed $octaves octaves leaves the MIDI range" 64 # EX_USAGE
done

################################################################################
# Execute.
################################################################################

args=()
for midi in "${chord[@]}"; do
	args+=(on "$midi" "$VELOCITY")
done
args+=("$timestamp")
for midi in "${chord[@]}"; do
	args+=(off "$midi" 0)
done

# Don't leave notes ringing if playback is cut short.
trap silence_chord INT TERM HUP

command sendmidi dev "$port" "${args[@]}" || error "unable to send to '$port'"
