#!/usr/bin/env bash

################################################################################
# Global variables.
################################################################################

_NAME="$(command basename "$0")"
_HELP_DOC="Shorten the URL using Chhoto URL, a self-hosted URL Shortener.

Usage:
  $_NAME [options] <url>

Options:
  -h	Print help.

Environment variables:
  URL_SHORTENER_AUTH_BASIC
  URL_SHORTENER_URL"
CURL_ARGS="--connect-timeout 2 --max-time 5"
SKIP_HTTP_PREFIX='true'

################################################################################
# Helper methods.
################################################################################

# Usage:
#       error <message> [<exit_code>]
error() {
	[[ ${2:-1} -eq 0 ]] && std_err_or_out=1 || std_err_or_out=2
	builtin echo "$_NAME: $1" >&"$std_err_or_out"
	exit "${2:-1}"
}

# Usage:
#       json_string <value>
json_string() {
	# Control characters are refused up front, so only these need escaping.
	local value="${1//\\/\\\\}"
	builtin printf '"%s"' "${value//\"/\\\"}"
}

# Usage:
#       builtin echo "text message" | pbcopy
pbcopy() {
	content="$(</dev/stdin)"
	if builtin type -P pbcopy >/dev/null; then
		builtin echo -n "$content" | command pbcopy
		return
	fi
	# Without a clipboard of our own, ask the terminal to set it (OSC 52). GNU
	# base64 wraps its output and BSD base64 doesn't, so join the lines either way.
	output="$(builtin printf '\e]52;c;%s\a' "$(builtin echo -n "$content" | command base64 | command tr -d '\n')")"
	# shellcheck disable=SC1003
	[[ -n "$TMUX" ]] && output="$(builtin printf '\ePtmux;\e%s\e\\' "$output")"
	builtin printf "%s" "$output"
}

################################################################################
# Validate input.
################################################################################

# Move options ahead of the URL so getopts sees them wherever they were passed.
options=()
operands=()
for arg in "$@"; do
	[[ "$arg" == -?* ]] && options+=("$arg") || operands+=("$arg")
done
set -- "${options[@]}" "${operands[@]}"
while getopts ":h" arg; do
	case $arg in
	h) # help
		builtin echo "$_HELP_DOC" && exit
		;;
	*)
		builtin echo "$_HELP_DOC" >&2 && exit 64 # EX_USAGE
		;;
	esac
done
shift $((OPTIND - 1))

[[ -z "$URL_SHORTENER_URL" ]] && error "missing environment variable, please set URL_SHORTENER_URL" 78 # EX_CONFIG
[[ $# -eq 0 ]] && error "missing input, please pass a URL" 64                                          # EX_USAGE
[[ $# -gt 1 ]] && error "invalid input, do not pass more than one URL" 64                              # EX_USAGE
url="$1"
[[ ! $url =~ ^https?://[^\.]+\..+$ || $url =~ [[:cntrl:]] ]] && error "invalid input, please pass a URL" 65 # EX_DATAERR

################################################################################
# Execute.
################################################################################

shortener_url="${URL_SHORTENER_URL%/}"
curl_auth_args=()
[[ -n $URL_SHORTENER_AUTH_BASIC ]] && curl_auth_args=(-u "$URL_SHORTENER_AUTH_BASIC")
# shellcheck disable=SC2086
response="$(
	command curl -qfsS $CURL_ARGS -X POST "${curl_auth_args[@]}" \
		-d "{\"longlink\":$(json_string "$url")}" "$shortener_url/api/new"
)" || error "unable to shorten the URL via $shortener_url"
[[ -z "$response" ]] && error "unknown error, missing response"
response="$shortener_url/$response"
[[ -n "$SKIP_HTTP_PREFIX" ]] && response="$(command sed -E 's|https?://||g' <<<"$response")"
builtin echo "$response"
[[ -t 1 ]] && builtin echo -n "$response" | pbcopy
exit 0
