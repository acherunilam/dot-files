#!/usr/bin/env bash

################################################################################
# Global variables.
################################################################################

_NAME="$(basename "$0")"
_HELP_DOC="Print the details of the IATA airport code or country code.

Usage:
  $_NAME <airport_code> [-v]
  $_NAME <airport_name>
  $_NAME <country_code>
  $_NAME <country_name> -c
  $_NAME (-i | -s)
  $_NAME -h

Options:
  -v    Print verbose details of the airport.
  -c    Look up the ISO 3166 two-letter country code by country name.
  -i    Install a cron job to periodically update the DB.
  -s    Sync the local DB to the latest version.
  -h    Print help."
CRON_SCHEDULE="0 5 * * 1" # every Mon 5 AM
CRON_COMMENT="# Update IATA/country DB."
CURL_ARGS="--connect-timeout 2 --max-time 30"
DB_PATH="$HOME/.local/share/iata"
# Splits each CSV row into f[], with the quotes dropped and any comma inside a
# field kept as "~" so the output can stay comma separated, and maps each header
# to its column in col[], as the upstream CSV gains columns over time.
# shellcheck disable=SC2016
_CSV_AWK='
function parse(    n, i, part, line) {
	n = split($0, part, "\"")
	line = ""
	for (i = 1; i <= n; i++) {
		if (i % 2 == 0) gsub(",", "~", part[i])
		line = line part[i]
	}
	return split(line, f, ",")
}
NR == 1 { header = $0; n = parse(); for (i = 1; i <= n; i++) col[f[i]] = i; next }
{ parse() }
'

################################################################################
# Helper methods.
################################################################################

# Usage
#       airport_search <keyword> (code | name)
airport_search() {
	# Parsing every row is slow, so let grep pick out the rows that can match
	# and keep the header for the column names. The keyword is matched as plain
	# text, and reaches awk through the environment since -v would read its
	# backslashes as escapes.
	{
		head -n1 "$DB_PATH/airports.csv"
		if [[ "$2" == "code" ]]; then
			grep -F -- "\"$1\"" "$DB_PATH/airports.csv"
		else
			grep -F -i -- "$1" "$DB_PATH/airports.csv"
		fi
	} | KEYWORD="$1" MODE="$2" awk -v OFS=, "$_CSV_AWK"'
		# The header itself can match the keyword too.
		NR > 1 && $0 == header { next }
		{
			code = f[col["iata_code"]]
			if (code == "") next
			if (ENVIRON["MODE"] == "code" && code != ENVIRON["KEYWORD"]) next
			print code, f[col["municipality"]], f[col["continent"]], f[col["iso_country"]], f[col["name"]],
				f[col["latitude_deg"]], f[col["longitude_deg"]], f[col["wikipedia_link"]]
		}
	'
}

# Usage:
#       country_code_to_name <country_code>
country_code_to_name() {
	KEYWORD="$1" awk "$_CSV_AWK"'
		f[col["code"]] == ENVIRON["KEYWORD"] { print f[col["name"]] }
	' "$DB_PATH/countries.csv"
}

# Usage:
#       country_name_search <keyword>
country_name_search() {
	KEYWORD="$1" awk "$_CSV_AWK"'
		index(toupper(f[col["name"]]), ENVIRON["KEYWORD"]) { print f[col["code"]] "  " f[col["name"]] }
	' "$DB_PATH/countries.csv"
}

# Usage:
#       install_cron_job
install_cron_job() {
	local current iata_path cron_entry
	if ! current="$(crontab -l 2>&1)"; then
		[[ "$current" == *"no crontab for"* ]] || error "unable to read the crontab: $current"
		current=""
	fi
	iata_path="$(realpath "$0")"
	cron_entry="$CRON_SCHEDULE $(printf '%q' "$iata_path") -s"
	# Replace any earlier entry for this script rather than add a duplicate, and
	# collapse the run of blank lines its removal leaves. The command
	# substitution drops any left at the end.
	current="$(
		awk -v comment="$CRON_COMMENT" -v job="$iata_path -s" '
			function emit(line) { if (line != "" || !blank) print line; blank = (line == "") }
			$0 == comment { held = 1; next }
			index($0, job) { held = 0; next }
			{ if (held) emit(comment); held = 0; emit($0) }
			END { if (held) emit(comment) }
		' <<<"$current"
	)"
	crontab - <<<"${current:+$current$'\n\n'}$CRON_COMMENT"$'\n'"$cron_entry" ||
		error "installation failed"
}

# Usage
#       download_iata_db <db>
download_iata_db() {
	# shellcheck disable=SC2086
	curl -qsS $CURL_ARGS \
		"https://raw.githubusercontent.com/davidmegginson/ourairports-data/main/$1.csv" \
		--create-dirs -o "$DB_PATH/$1.csv.new" ||
		error "unable to reach raw.githubusercontent.com" 69 # EX_UNAVAILABLE
	if head -n1 "$DB_PATH/$1.csv.new" 2>/dev/null | grep -aq '"name"'; then
		mv "$DB_PATH/$1.csv.new" "$DB_PATH/$1.csv" ||
			error "unable to replace '$DB_PATH/$1.csv'" 73 # EX_CANTCREAT
	else
		rm -f "$DB_PATH/$1.csv.new"
		error "download failed" 76 # EX_PROTOCOL
	fi
}

# Usage:
#       error <message> [<exit_code>]
error() {
	[[ ${2:-1} -eq 0 ]] && std_err_or_out=1 || std_err_or_out=2
	echo "$_NAME: $1" >&"$std_err_or_out"
	exit "${2:-1}"
}

################################################################################
# Validate input.
################################################################################

country=0
verbose=0
# Move options ahead of the input so getopts sees them wherever they were passed.
options=()
operands=()
for arg in "$@"; do
	[[ "$arg" == -?* ]] && options+=("$arg") || operands+=("$arg")
done
set -- "${options[@]}" "${operands[@]}"
while getopts ":cisvh" arg; do
	case $arg in
	c) # country
		country=1
		;;
	i) # install
		install_cron_job && error "installed cron tab" 0
		;;
	s) # sync
		download_iata_db "airports"
		download_iata_db "countries"
		error "synced DB" 0
		;;
	v) # verbose
		verbose=1
		;;
	h) # help
		echo "$_HELP_DOC" && exit
		;;
	*)
		echo "$_HELP_DOC" >&2 && exit 64 # EX_USAGE
		;;
	esac
done
shift $((OPTIND - 1))

[[ $# -eq 0 ]] &&
	error "missing input, please pass an airport code, country code, or city" 64 # EX_USAGE
[[ ! -f "$DB_PATH/airports.csv" ]] && download_iata_db "airports"
[[ ! -f "$DB_PATH/countries.csv" ]] && download_iata_db "countries"
input="${*^^}"

################################################################################
# Execute.
################################################################################

if [[ $country -eq 1 ]]; then # country reverse lookup
	result="$(country_name_search "$input" | sort -k2)"
else
	if [[ ${#input} -eq 2 ]]; then # country code
		result="$(country_code_to_name "$input")"
	elif [[ ${#input} -eq 3 ]]; then # IATA code
		info="$(airport_search "$input" code)"
		IFS=, read -r iata city continent country_code name latitude longitude wiki <<<"$info"
		country="$(country_code_to_name "$country_code")"
		if [[ -n "$info" ]]; then
			if [[ $verbose -eq 0 ]]; then
				result="$city, $country"
			else
				result="$(
					echo "iata|$iata
name|$name
city|$city
country|$country
continent|$continent
maps|https://www.google.com/maps/search/?api=1&query=$latitude%2C$longitude
wiki|$wiki" |
						column -t -s"|"
				)"
			fi
		fi
	else # IATA code reverse lookup
		result="$(
			airport_search "$input" name |
				cut -d, -f1,2,4,5 |
				sed -E 's/(...),(.*),(..),(.*)/\1\|\4\|\2, \3/g' |
				column -t -s"|" |
				sort -k2
		)"
	fi
fi

# No match is an answer rather than an error.
[[ -z "$result" ]] && exit 0
echo "$result" | sed 's/~/,/g'
